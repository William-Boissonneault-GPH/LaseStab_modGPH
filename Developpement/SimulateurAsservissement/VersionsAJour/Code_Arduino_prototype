ISR(TIMER1_COMPA_vect) {
  // 1. Read ADC values for the two thermistors
  int adcValue1 = analogRead(THERMISTOR_PIN1);
  int adcValue2 = analogRead(THERMISTOR_PIN2);

  // 2. Convert ADC readings to temperatures (in °C)
  T1 = getTemperatureC(adcValue1);
  T2 = getTemperatureC(adcValue2);

  // 3. Estimate T3 using the discrete filter (low-pass on the average of T1 and T2)
  T3 = getEstimationCT3(T1, T2);

  // 4. Compute the error between the goal temperature and the estimated temperature
  error = T_goal - T3;

  // 5. Update the PID controller (discrete-time)
  integral += error * dt;
  float derivative = (error - previous_error) / dt;
  float control_signal = Kp * error + Ki * integral + Kd * derivative;
  previous_error = error;

  // 6. Map the control signal to PWM range.
  //    Here we assume control_signal is already scaled. Otherwise, you might want to scale it.
  //    For example, you can constrain the output and then map it:
  control_signal = constrain(control_signal, PWM_MIN, PWM_MAX);
  pwmValue = (int)control_signal;

  // 7. Write the PWM value to the output pin
  analogWrite(PWM_OUTPUT_PIN, pwmValue);
}
